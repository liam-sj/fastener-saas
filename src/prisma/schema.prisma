// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum TenantStatus {
  active
  inactive
}

enum UserRole {
  admin
  manager
  staff
}

enum QuotationStatus {
  draft
  sent
  accepted
  rejected
  superseded
}

enum OrderStatus {
  pending
  accepted
  sourcing
  producing
  ready_to_ship
  partial_delivered
  delivered
  completed
  cancelled
}

enum OrderItemSource {
  stock
  custom
}

enum RevisionType {
  add
  modify
  remove
}

enum PurchaseOrderStatus {
  pending
  confirmed
  partial_received
  received
  cancelled
}

enum InboundOrderStatus {
  pending
  confirmed
}

enum DeliveryOrderStatus {
  pending
  shipped
  signed
}

enum SettlementStatus {
  pending
  paid
}

// ============================================================
// 新增枚举 — 订购到对账业务流程
// ============================================================

/// 订购单状态
enum PurchaseRequestStatus {
  pending
  quoting
  quoted
  accepted
  rejected
  cancelled
}

/// 生产工单状态
enum ProductionOrderStatus {
  planning
  in_progress
  partial_done
  done
  cancelled
}

/// 工序状态
enum ProcessStepStatus {
  pending
  in_progress
  done
  skipped
}

/// 工序阶段(阶段间顺序固定:备料→成型→螺纹→后处理)
enum ProcessStage {
  preparation
  forming
  threading
  post_treatment
}

/// 工序类型
enum ProcessStepType {
  feeding
  turning
  milling
  grinding
  drilling
  rolling
  heat_treatment
  surface_treatment
}

/// 工序加工方式
enum ProcessStepMethod {
  self
  outsource
}

/// 采购单用途
enum PurchasePurpose {
  material
  outsource
  finished_goods
}

// ============================================================
// Models
// ============================================================

model Tenant {
  id        Int          @id @default(autoincrement())
  name      String
  contact   String?
  phone     String?
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now())

  users                   User[]
  customers               Customer[]
  suppliers               Supplier[]
  categories              Category[]
  products                Product[]
  skus                    Sku[]
  quotations              Quotation[]
  orders                  Order[]
  orderItems              OrderItem[]
  orderRevisions          OrderRevision[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrderItems      PurchaseOrderItem[]
  inboundOrders           InboundOrder[]
  inboundOrderItems       InboundOrderItem[]
  deliveryOrders          DeliveryOrder[]
  deliveryItems           DeliveryItem[]
  settlements             Settlement[]
  sequences               Sequence[]
  purchaseRequests        PurchaseRequest[]
  purchaseRequestItems    PurchaseRequestItem[]
  productionOrders        ProductionOrder[]
  processSteps            ProcessStep[]

  @@map("tenants")
}

model User {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  username  String
  password  String
  role      UserRole @default(staff)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  inboundOrders  InboundOrder[]

  @@unique([tenantId, username])
  @@map("users")
}

model Customer {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  name      String
  contact   String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  quotations       Quotation[]
  orders           Order[]
  purchaseRequests PurchaseRequest[]

  @@map("customers")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  name      String
  contact   String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders  PurchaseOrder[]

  @@map("suppliers")
}

/// Category self-referential tree
model Category {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  name          String
  parentId      Int?
  specTemplate  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  categoryId  Int
  name        String
  description String?
  images      String[]
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  skus     Sku[]

  @@map("products")
}

model Sku {
  id          Int     @id @default(autoincrement())
  tenantId    Int
  productId   Int
  skuCode     String
  attributes  Json?
  price       Decimal @db.Decimal(10, 2)
  costPrice    Decimal  @default(0) @db.Decimal(10, 2)
  stock       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, skuCode])
  @@index([tenantId, skuCode])
  @@map("skus")
}

model Quotation {
  id                 Int              @id @default(autoincrement())
  tenantId           Int
  quotationNo        String           @unique
  purchaseRequestId  Int?
  version            Int              @default(1)
  customerId         Int
  items              Json
  totalAmount        Decimal          @db.Decimal(12, 2)
  status             QuotationStatus  @default(draft)
  validUntil         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  purchaseRequest  PurchaseRequest?  @relation(fields: [purchaseRequestId], references: [id])
  orders           Order[]

  @@unique([purchaseRequestId, version])
  @@index([tenantId, createdAt])
  @@map("quotations")
}

model Order {
  id                 Int         @id @default(autoincrement())
  tenantId           Int
  orderNo            String      @unique
  purchaseRequestId  Int?
  quotationId        Int?
  customerId         Int
  totalAmount        Decimal     @db.Decimal(12, 2)
  paidAmount         Decimal     @default(0) @db.Decimal(12, 2)
  status             OrderStatus @default(accepted)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  quotation        Quotation?        @relation(fields: [quotationId], references: [id])
  purchaseRequest  PurchaseRequest?  @relation(fields: [purchaseRequestId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  items            OrderItem[]
  revisions        OrderRevision[]
  deliveryOrders   DeliveryOrder[]
  settlements      Settlement[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("orders")
}

model OrderItem {
  id              Int              @id @default(autoincrement())
  tenantId        Int
  orderId         Int
  productName     String
  skuCode         String
  skuAttrs        Json?
  price           Decimal          @db.Decimal(10, 2)
  qty             Int
  deliveredQty    Int              @default(0)
  source          OrderItemSource  @default(stock)
  costPrice       Decimal?         @db.Decimal(10, 2)
  purchaseOrderId Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  order           Order           @relation(fields: [orderId], references: [id])
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  productionOrder ProductionOrder?
  deliveryItems   DeliveryItem[]
  settlements     Settlement[]

  @@index([tenantId, orderId])
  @@index([tenantId, skuCode])
  @@map("order_items")
}

model OrderRevision {
  id          Int          @id @default(autoincrement())
  tenantId    Int
  orderId     Int
  type        RevisionType
  beforeData  Json?
  afterData   Json?
  reason      String?
  createdAt   DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@map("order_revisions")
}

model PurchaseOrder {
  id                Int                  @id @default(autoincrement())
  tenantId          Int
  purchaseNo        String               @unique
  supplierId        Int
  totalAmount       Decimal              @db.Decimal(12, 2)
  status            PurchaseOrderStatus  @default(pending)
  expectedDate      DateTime?
  purpose           PurchasePurpose      @default(finished_goods)
  orderItemId       Int?
  processStepId     Int?
  productionOrderId Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  items          PurchaseOrderItem[]
  orderItems     OrderItem[]
  inboundOrders  InboundOrder[]
  processStep    ProcessStep?   @relation(fields: [processStepId], references: [id])
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, supplierId])
  @@index([tenantId, purpose])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  purchaseOrderId Int
  productName     String
  skuCode         String
  skuAttrs        Json?
  qty             Int
  receivedQty     Int      @default(0)
  unitPrice       Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  inboundOrderItems InboundOrderItem[]

  @@map("purchase_order_items")
}

model InboundOrder {
  id              Int                @id @default(autoincrement())
  tenantId        Int
  inboundNo       String             @unique
  purchaseOrderId Int?
  status          InboundOrderStatus @default(pending)
  operatorId      Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  operator      User?               @relation(fields: [operatorId], references: [id])
  items         InboundOrderItem[]

  @@index([tenantId, createdAt])
  @@map("inbound_orders")
}

model InboundOrderItem {
  id                  Int      @id @default(autoincrement())
  tenantId            Int
  inboundOrderId      Int
  purchaseOrderItemId Int?
  skuCode             String
  productName         String
  skuAttrs            Json?
  qty                 Int
  unitCost            Decimal  @db.Decimal(10, 2)
  createdAt           DateTime @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  inboundOrder      InboundOrder       @relation(fields: [inboundOrderId], references: [id])
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@map("inbound_order_items")
}

model DeliveryOrder {
  id               Int                  @id @default(autoincrement())
  tenantId         Int
  deliveryNo       String               @unique
  orderId          Int
  logisticsCompany String?
  trackingNo       String?
  status           DeliveryOrderStatus  @default(pending)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  order  Order         @relation(fields: [orderId], references: [id])
  items  DeliveryItem[]

  @@index([tenantId, createdAt])
  @@map("delivery_orders")
}

model DeliveryItem {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  deliveryOrderId Int
  orderItemId     Int
  qty             Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@map("delivery_items")
}

model Settlement {
  id          Int              @id @default(autoincrement())
  tenantId    Int
  orderId     Int
  orderItemId Int
  amount      Decimal          @db.Decimal(10, 2)
  paidAt      DateTime?
  status      SettlementStatus @default(pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("settlements")
}

model Sequence {
  id       Int    @id @default(autoincrement())
  tenantId Int
  prefix   String
  dateStr  String
  seq      Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, prefix, dateStr])
  @@map("sequences")
}

// ============================================================
// 新增模型 — 订购到对账业务流程
// ============================================================

/// 订购单 — 客户原始需求入口
model PurchaseRequest {
  id            Int                    @id @default(autoincrement())
  tenantId      Int
  requestNo     String                 @unique
  customerId    Int
  status        PurchaseRequestStatus  @default(pending)
  expectedDate  DateTime?
  remark        String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  tenant   Tenant                  @relation(fields: [tenantId], references: [id])
  customer Customer                @relation(fields: [customerId], references: [id])
  items    PurchaseRequestItem[]
  quotations Quotation[]
  orders   Order[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("purchase_requests")
}

/// 订购单条目
model PurchaseRequestItem {
  id                  Int     @id @default(autoincrement())
  tenantId            Int
  purchaseRequestId   Int
  productName         String
  specText            String?
  attributes          Json?
  qty                 Int
  targetPrice         Decimal?  @db.Decimal(10, 2)
  skuId               Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  purchaseRequest  PurchaseRequest  @relation(fields: [purchaseRequestId], references: [id])

  @@index([tenantId, purchaseRequestId])
  @@map("purchase_request_items")
}

/// 生产工单 — 定制件的生产项目(1:1 关联 OrderItem)
model ProductionOrder {
  id                 Int                  @id @default(autoincrement())
  tenantId           Int
  productionNo       String               @unique
  orderItemId        Int                  @unique
  qty                Int
  completedQty       Int                  @default(0)
  status             ProductionOrderStatus @default(planning)
  plannedFinishDate  DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id])
  processSteps ProcessStep[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("production_orders")
}

/// 工序 — 生产工单内的工序链
model ProcessStep {
  id                  Int                @id @default(autoincrement())
  tenantId            Int
  productionOrderId   Int
  sequence            Int
  stage               ProcessStage
  stepType            ProcessStepType
  name                String
  type                ProcessStepMethod  @default(self)
  supplierId          Int?
  purchaseOrderId     Int?
  surfaceMethod       String?
  status              ProcessStepStatus  @default(pending)
  plannedQty          Int                @default(0)
  actualQty           Int                @default(0)
  lossQty             Int                @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  remark              String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id])
  purchaseOrders  PurchaseOrder[]

  @@index([tenantId, productionOrderId])
  @@index([tenantId, status])
  @@unique([productionOrderId, sequence])
  @@map("process_steps")
}
